{
  "name": "devex",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build:ios": "react-native bundle --entry-file='index.js' --bundle-output='./ios/main.jsbundle' --dev=false --platform='ios'",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "start": "react-native start",
    "test": "APP_ENV=test jest --maxWorkers=50%",
    "prepare": "husky install",
    "ts": "tsc --noEmit --project tsconfig.lint.json",
    "generate": "graphql-codegen --config ./codegen.yaml"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.4.0",
    "@fortawesome/free-brands-svg-icons": "^6.4.0",
    "@fortawesome/free-regular-svg-icons": "^6.4.0",
    "@fortawesome/free-solid-svg-icons": "^6.4.0",
    "@fortawesome/react-native-fontawesome": "^0.3.0",
    "@react-native-async-storage/async-storage": "^1.18.2",
    "@react-native-firebase/app": "18.7.3",
    "@react-native-firebase/auth": "18.7.3",
    "@react-native-firebase/remote-config": "18.7.3",
    "@react-native-masked-view/masked-view": "^0.2.9",
    "@react-native/new-app-screen": "0.80.1",
    "@react-navigation/bottom-tabs": "^6.5.9",
    "@react-navigation/native": "^6.1.6",
    "@react-navigation/stack": "^6.3.16",
    "@reduxjs/toolkit": "^1.9.5",
    "@shopify/restyle": "^2.4.2",
    "@tanstack/query-async-storage-persister": "^5.10.0",
    "@tanstack/react-query": "^5.10.0",
    "@tanstack/react-query-persist-client": "^5.10.0",
    "axios": "^1.5.1",
    "buffer": "^6.0.3",
    "dayjs": "^1.11.13",
    "graphql": "^16.11.0",
    "react": "19.1.0",
    "react-native": "0.80.1",
    "react-native-config": "^1.5.1",
    "react-native-encrypted-storage": "^4.0.3",
    "react-native-gesture-handler": "^2.9.0",
    "react-native-linear-gradient": "^2.8.1",
    "react-native-reanimated": "^3.0.2",
    "react-native-restart": "^0.0.27",
    "react-native-safe-area-context": "5.5.1",
    "react-native-screens": "^3.27.0",
    "react-native-splash-screen": "^3.3.0",
    "react-native-svg": "15.12.0",
    "react-native-uuid": "^2.0.3",
    "react-redux": "^8.1.1",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-react": "7.25.9",
    "@babel/preset-typescript": "7.26.0",
    "@babel/runtime": "^7.25.0",
    "@graphql-codegen/cli": "5.0.3",
    "@graphql-codegen/client-preset": "4.5.1",
    "@graphql-codegen/near-operation-file-preset": "3.0.0",
    "@graphql-codegen/typescript": "4.1.2",
    "@graphql-codegen/typescript-operations": "4.4.1",
    "@graphql-codegen/typescript-react-query": "6.1.0",
    "@react-native-community/cli": "19.0.0",
    "@react-native-community/cli-platform-android": "19.0.0",
    "@react-native-community/cli-platform-ios": "19.0.0",
    "@react-native/babel-preset": "0.80.1",
    "@react-native/metro-config": "0.80.1",
    "@react-native/typescript-config": "0.80.1",
    "@testing-library/jest-native": "5.4.3",
    "@testing-library/react-hooks": "8.0.1",
    "@testing-library/react-native": "12.9.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.0",
    "@types/react-native": "^0.70.6",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^5.37.0",
    "@typescript-eslint/parser": "^5.37.0",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "8.53.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "husky": "^9.1.7",
    "jest": "^29.2.1",
    "prettier": "^2.4.1",
    "react-native-device-info": "^10.11.0",
    "react-native-svg-transformer": "^1.0.0",
    "react-test-renderer": "18.2.0",
    "typescript": "^4.8.4"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "preset": "react-native",
    "collectCoverage": true,
    "collectCoverageFrom": [
      "./src/**/*.+(t|j)s*(x)",
      "!./src/assets/icons/**/*.tsx",
      "!./src/**/index.ts"
    ],
    "coverageReporters": [
      [
        "text",
        {
          "file": "full-coverage.txt"
        }
      ],
      "text-summary",
      "lcov",
      "cobertura"
    ],
    "coverageDirectory": "./coverage",
    "coverageThreshold": {
      "global": {
        "statements": 88,
        "branches": 79,
        "functions": 84,
        "lines": 88
      }
    },
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect",
      "./node_modules/react-native-gesture-handler/jestSetup.js",
      "./src/testing/setup-jest-tests.ts"
    ],
    "setupFiles": [
      "./node_modules/react-native-gesture-handler/jestSetup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/?!(react-navigation)",
      "jest-runner"
    ],
    "testPathIgnorePatterns": [
      "./ios"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "snapshotFormat": {
      "escapeString": true,
      "printBasicPrototype": true
    },
    "workerIdleMemoryLimit": "512MB"
  }
}
